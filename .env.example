# Copie para .env (na mesma pasta) e preencha. O .env não vai para o Git.

# App do Mercado Livre DA EXTENSÃO (não o do Replique), escopos read + offline_access
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Local: callback do Postman (o ML não aceita localhost). Hospedado: https://SEU-DOMINIO/api/ml/callback
ML_REDIRECT_URI=https://oauth.pstmn.io/v1/callback

# Para onde o cliente volta depois de conectar (landing)
MONVATTI_LANDING_URL=http://localhost:3100

# Código de login por e-mail (SMTP). Sem isto, o código aparece no log do servidor
# (e na própria extensão, enquanto MONVATTI_MODO_DEMO=true).
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Monvatti Marketplace <nao-responda@monvatti.com.br>
