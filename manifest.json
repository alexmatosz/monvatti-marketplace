{
  "manifest_version": 3,
  "name": "Monvatti Pro",
  "version": "0.1.0",
  "description": "Monvatti Pro: estudo de anúncios do Mercado Livre, fotos salvas e cadastro no Replique. Uso interno da equipe Monvatti.",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://*.mercadolivre.com.br/*"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Monvatti Pro", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://*.mercadolivre.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
